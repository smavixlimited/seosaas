# =============================================================================
# Skorvia SaaS — Production Environment Configuration (.env)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Database & Storage Providers
# -----------------------------------------------------------------------------
# Option A: Cloudflare D1 Serverless (Default SQLite edge database)
#DATABASE_PROVIDER=d1

# Option B: Supabase / Neon / Managed PostgreSQL (Uncomment below for Postgres)
  # Database Settings
DATABASE_PROVIDER="postgres"
POSTGRES_DATABASE_URL=""
DATABASE_URL=""

# -----------------------------------------------------------------------------
# 2. Authentication & Security (Better Auth)
# -----------------------------------------------------------------------------
AUTH_MODE=hosted
BETTER_AUTH_SECRET=&mlJTKHDGcfMN;CJYKisF?VKFH,2~t8CiEP
BETTER_AUTH_URL=https://skorvia.live
# Google OAuth for 1-Click Social Login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local SEO / Google Places API Key (For Place search & rank grids)
GOOGLE_MAPS_API_KEY=
# Cloudflare Turnstile Bot Defense
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# 3. SEO Intelligence Data Providers
# -----------------------------------------------------------------------------
# DataForSEO API Credentials (SERP, Backlinks, Site Audits, Keyword Volume)
DATAFORSEO_API_KEY=
# Or provide username and password separately:
# DATAFORSEO_LOGIN=your-dataforseo-login-email
# DATAFORSEO_PASSWORD=your-dataforseo-api-password

# -----------------------------------------------------------------------------
# 4. Multi-LLM & AI Search Optimization (SAM AI Copilot & AEO)
# -----------------------------------------------------------------------------
# OpenRouter API Key (Powers Claude 3.5 Sonnet, GPT-4o, DeepSeek-V3)
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-openrouter-key
# Anthropic Direct API Key (Optional fallback)
ANTHROPIC_API_KEY=sk-ant-api03-replace-with-anthropic-key
# OpenAI Direct API Key (Optional fallback)
OPENAI_API_KEY=
# -----------------------------------------------------------------------------
# 5. Multi-Currency Payment Gateways (Nigeria NGN & Global USD)
# -----------------------------------------------------------------------------
# Paystack (Nigeria NGN Cards, Bank Transfer, USSD)
PAYSTACK_SECRET_KEY=sk_live_replace_with_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_replace_with_paystack_public_key

# Flutterwave (Pan-African & International Payments)
FLUTTERWAVE_SECRET_KEY=FLWSECK-replace_with_flutterwave_secret_key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-replace_with_flutterwave_public_key
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_APIC_replace_with_encryption_key

# LemonSqueezy (Global SaaS MoR & Card Payments)
LEMONSQUEEZY_API_KEY=replace-with-lemonsqueezy-api-key
LEMONSQUEEZY_STORE_ID=replace-with-store-id
LEMONSQUEEZY_WEBHOOK_SECRET=replace-with-webhook-secret

# -----------------------------------------------------------------------------
# 6. Transactional Emails (Resend & Loops)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Skorvia <notifications@skorvia.live>

# Loops Fallback (Optional)
# LOOPS_API_KEY=replace-with-your-loops-api-key
# LOOPS_TRANSACTIONAL_VERIFY_EMAIL_ID=replace-with-loops-verify-template-id
# LOOPS_TRANSACTIONAL_RESET_PASSWORD_ID=replace-with-loops-reset-template-id

# -----------------------------------------------------------------------------
# 7. Analytics, Telemetry & PostHog
# -----------------------------------------------------------------------------
POSTHOG_PUBLIC_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# 8. Server Runtime Configuration
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=production
ALLOWED_HOST=skorvia.live
